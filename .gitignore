# ── Secrets & credentials (NEVER commit) ──
.env
*.env
!*.env.example
sashaops_app/.env
credentials.json
token.json
sashaops_app/credentials.json
sashaops_app/token.json

# ── Databases & encrypted client data ──
*.db
*.db-wal
*.db-shm
sashaops_app/data/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ── Temp / regenerated caches ──
.tmp/
sashaops_app/.tmp/
sashaops_app/reports/generated/
# Playwright browser binaries (installed via `playwright install chromium`, ~550MB).
# /app is bind-mounted onto this directory, so an install lands here, not in a
# separate container layer - must be excluded or it bloats the repo with binaries.
.cache/
sashaops_app/.cache/

# ── Test config (excluded from published repo) ──
# Tests themselves ARE tracked: they enforce the accuracy guarantees on every clone
# and CI run, and Task 2.4 requires a committed scraper test battery.
pytest.ini
sashaops_app/pytest.ini
pyproject.toml
sashaops_app/pyproject.toml

# ── Dev / debug scratch ──
sashaops_app/verify_luck.py
sashaops_app/check_db.py
sashaops_app/nul
nul

# ── Agent / editor config (not part of the app) ──
CLAUDE.md
sashaops_app/CLAUDE.md
.claude/
.DS_Store
