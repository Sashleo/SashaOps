# ── SashaOps Environment Variables ───────────────────────────────────────────
# Copy this to .env and fill in your values. Never commit .env to git.

# Google Gemini API key — get from https://ai.google.dev
GOOGLE_API_KEY=your-gemini-api-key-here

# App secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=generate-a-64-char-random-string-here

# Database path inside container
DATABASE_PATH=/app/data/sashaops.db

# Document storage path inside container
DOCUMENTS_PATH=/app/data/documents

# Master password for database encryption
DB_MASTER_PASSWORD=set-a-strong-password-here

# App settings
APP_NAME=SashaOps
APP_VERSION=1.0.0
DEBUG=false
SESSION_EXPIRE_HOURS=2
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
